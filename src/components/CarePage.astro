---
import Layout from "../layouts/Layout.astro";
import { care, careUrl, bySource, sourceFacts } from "../lib/care";
interface Props {
  record: (typeof care)[number];
}
const { record: r } = Astro.props;
const evidence = sourceFacts[r.sourcePath]?.evidenceNote;
const related = r.related
  .map(bySource)
  .filter((x): x is (typeof care)[number] => Boolean(x));
---

<Layout title={r.title} description={r.intro} light>
  <header class="wrap page-intro">
    <p class="breadcrumb">
      <a href="/care/">Care</a> /{" "}
      {r.kind === "concern" ? "Concerns" : "Treatments"}
    </p>
    <p class="eyebrow">A consultation companion</p>
    <h1>{r.title}</h1>
    <p class="lead">{r.intro}</p>
  </header>
  <article class="wrap reading">
    <p class="meta">
      Dr. Jee Hoon Ju’s care library · English
      <br />
      Clinic source checked October 16, 2026. General information; suitability
      and your treating physician are confirmed at Tune Clinic.
    </p>
    <section class="panel" style="margin-top:35px">
      <h2 style="margin-top:0">Bring these questions</h2>
      <ul>
        {r.questions.map((q) => (
          <li>{q}</li>
        ))}
      </ul>
    </section>
    {r.sections.map((s) => (
      <section>
        <h2>{s.title}</h2>
        <p>{s.text}</p>
      </section>
    ))}
    {evidence && (
      <section>
        <h2>A source to discuss</h2>
        <p>{evidence.reader}</p>
        <p>{evidence.scope}</p>
        <p class="fineprint">{evidence.limitation}</p>
        <a
          class="text-link"
          href={evidence.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read the cited publication · PubMed {evidence.pmid} ↗
        </a>
      </section>
    )}
    <section>
      <h2>Current clinic information</h2>
      <p>
        For the current menu, product availability and published prices, see the
        clinic’s information below. Ask for a full quote after assessment,
        including the selected treatment scope and any optional additions.
      </p>
      <a
        class="text-link"
        href={`https://tuneclinic-global.com${r.sourcePath}`}
      >
        View {r.title} at Tune Clinic ↗
      </a>
      <p class="fineprint" style="margin-top:20px">
        This page is a consultation aid, not an individual recommendation.
        Information about a device or product does not establish its suitability
        for you.
      </p>
    </section>
    {related.length > 0 && (
      <section>
        <h2>Continue exploring</h2>
        <div>
          {related.map((x) => (
            <a class="index-card" href={careUrl(x)}>
              <h3>{x.title} ↗</h3>
            </a>
          ))}
        </div>
      </section>
    )}
    <section>
      <h2>Discuss your options</h2>
      <p>
        Book a general consultation at Tune Clinic. Selecting a topic does not
        commit you to treatment or guarantee Dr. Ju as your physician.
      </p>
      <a
        class="button"
        style="text-decoration:none"
        href="/book/"
        data-event="booking_cta"
      >
        Book at Tune Clinic ↗
      </a>
    </section>
  </article>
</Layout>
