---
import "../styles/global.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
interface Props {
  title: string;
  description: string;
  light?: boolean;
  noindex?: boolean;
}
const { title, description, light = false, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, "https://jeehoonju.com").href;
const nav = [
  ["Dr. Ju", "/about/"],
  ["Care", "/care/"],
  ["Building", "/building/"],
  ["Notes", "/notes/"],
];
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
  isPartOf: {
    "@type": "WebSite",
    name: "Dr. Jee Hoon Ju",
    url: "https://jeehoonju.com/",
  },
  about: {
    "@type": "Person",
    "@id": "https://jeehoonju.com/about/#person",
    name: "Jee Hoon Ju",
    honorificPrefix: "Dr.",
    url: "https://jeehoonju.com/about/",
    image: "https://jeehoonju.com/images/dr-ju.webp",
    jobTitle: "Physician and founder",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta
      name="google-site-verification"
      content="JVZZLNoc59DeS9WL4iHj3CVTfv6ef_Mv8GzqTuE2xIo"
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#080D18" />
    <title>{title} | Dr. Jee Hoon Ju</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | Dr. Jee Hoon Ju`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://jeehoonju.com/images/dr-ju.webp"
    />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body class:list={[light && "light-page"]}>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Dr. Jee Hoon Ju home">
        <span class="brand-star">✧</span> Jee Hoon Ju
        <span class="degree">MD</span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(([label, url]) => (
          <a
            href={url}
            aria-current={path.startsWith(url) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <a class="button small" href="/book/" data-event="booking_cta">
        Book a visit <span aria-hidden="true">↗</span>
      </a>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation"
      >
        ☰
      </button>
    </header>
    <nav
      id="mobile-nav"
      class="mobile-nav"
      aria-label="Mobile navigation"
      hidden
    >
      {nav.map(([label, url]) => (
        <a href={url}>{label}</a>
      ))}
      <a href="/visit/">Your visit</a>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div class="footer-top">
        <a class="wordmark" href="/">
          Jee Hoon Ju<span class="degree">MD</span>
        </a>
        <p>
          Medicine, with perspective.
          <br />
          Technology, with purpose.
        </p>
        <a class="text-link" href="/book/">
          Plan your visit ↗
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Jee Hoon Ju</span>
        <a href="/visit/">Tune Clinic · Seoul</a>
        <a href="/errata/">Founder’s Errata ↗</a>
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <button class="text-button" data-cookie-settings>
          Cookie settings
        </button>
      </div>
      <p class="fineprint">
        This is Dr. Ju’s personal website. Clinical appointments and treatment
        are managed by Tune Clinic. Online information supports a conversation
        with your physician; individual suitability requires an assessment.
      </p>
    </footer>
    <div class="cookie-banner" hidden>
      <p>
        Optional analytics help us understand which pages are useful. Booking
        details are never sent to analytics.
      </p>
      <div>
        <button data-consent="yes" class="button small">
          Allow analytics
        </button>
        <button data-consent="no" class="button secondary small">
          Essential only
        </button>
      </div>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        if (menu) menu.hidden = !open;
      });
    </script>
    <script>
      import "../lib/analytics";
    </script>
  </body>
</html>
