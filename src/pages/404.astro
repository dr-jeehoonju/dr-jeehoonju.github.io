>
  <section class="wrap section">
    <p class="eyebrow">404</p>
    <h1>
      A different
      <br />
      <em>direction.</em>
    </h1>
    <p class="lead">
      This page is not available. Explore the care library or return home.
    </p>
    <div class="actions">
      <a class="button" href="/">
        Return home ↗
      </a>
      <a class="text-link" href="/care/">
        Explore care
      </a>
    </div>
  </section>
</Layout>
