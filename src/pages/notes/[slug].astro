---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { formatNoteDate } from "../../lib/notes";
import "../../styles/notes.css";
export async function getStaticPaths() {
  return (await getCollection("notes", ({ data }) => !data.draft)).map(
    (entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }),
  );
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, date, tags, canonical, republished } =
  entry.data;
const lang = entry.data.lang ?? "en";
const articleUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  inLanguage: lang,
  articleSection: category,
  ...(date && { datePublished: date }),
  ...(tags?.length && { keywords: tags }),
  author: {
    "@type": "Person",
    "@id": "https://jeehoonju.com/about/#person",
    name: "Jee Hoon Ju",
    url: "https://jeehoonju.com/about/",
  },
};
---

<Layout
  title={title}
  description={description}
  light
  lang={lang}
  canonical={canonical}
  bodyClass="article-page"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
  />
  <article class="reading-shell" lang={lang} aria-labelledby="article-title">
    <header class="article-header">
      <p class="breadcrumb">
        <a href="/notes/">← {lang === "ko" ? "전체 글" : "All notes"}</a>
      </p>
      <p class="eyebrow">{category}</p>
      <h1 id="article-title">{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="article-meta">
        <div class="byline">
          <a href="#author" lang="en">
            Dr. Jee Hoon Ju
          </a>
          {date ? (
            <time datetime={date}>{formatNoteDate(date, lang)}</time>
          ) : (
            <span>{lang === "ko" ? "날짜 미상" : "Undated"}</span>
          )}
          <span>{lang === "ko" ? "한국어" : "English"}</span>
        </div>
        {tags?.length ? (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        ) : null}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <aside
      class="author-block"
      id="author"
      lang="en"
      aria-label="About the author"
    >
      <img
        src="/images/dr-ju.webp"
        alt="Dr. Jee Hoon Ju"
        width="64"
        height="80"
        loading="lazy"
      />
      <div>
        <h2>Jee Hoon Ju, MD</h2>
        <p class="author-titles">
          International Director, Tune Clinic Seoul · CEO, AetherHeal
        </p>
        <p>
          I see patients in Seoul every week. I write these notes so you can
          make an informed choice, not to bring you to my chair. The decision
          is yours. What I owe you is the whole picture, and I put my name to
          every line here. If a question stays with you after reading, send it
          to me on WhatsApp, LINE or Telegram and I will answer it myself.
        </p>
        <p class="author-contact">
          <a href="https://wa.me/821098748575" rel="noopener">WhatsApp</a> ·{" "}
          <a href="https://line.me/ti/p/S_ewS8UAKv" rel="noopener">LINE</a> ·{" "}
          <a href="https://t.me/drjeeju" rel="noopener">Telegram</a> ·{" "}
          <a href="mailto:drjeeju@aetherheal.com">drjeeju@aetherheal.com</a> ·{" "}
          <a href="/about/">About Dr. Ju ↗</a>
        </p>
        <img
          class="author-clinic-photo"
          src="/images/tune-clinic-lobby.webp"
          alt="The reception desk and lounge at Tune Clinic Seoul"
          width="1260"
          height="840"
          loading="lazy"
        />
        <p class="author-clinic">
          Tune Clinic Seoul<br />
          4F, Apgujeong Securities Building, 14 Nonhyeon-ro 176-gil,
          Gangnam-gu, Seoul 06026, Republic of Korea<br />
          Mon-Thu 11:00-20:00 / Fri 11:00-21:00 / Sat 10:00-16:00 / Sun closed
          (KST)
        </p>
      </div>
    </aside>
    {republished?.length ? (
      <p class="republished">
        {lang === "ko" ? "다른 곳에서 읽기: " : "Republished on: "}
        {republished.map(({ name, url }, index) => (
          <>
            {index > 0 && " · "}
            <a href={url}>{name}</a>
          </>
        ))}
      </p>
    ) : null}
    <a class="back-link" href="/notes/">
      ← {lang === "ko" ? "전체 글로 돌아가기" : "Back to all notes"}
    </a>
  </article>
</Layout>
